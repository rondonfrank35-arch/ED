class FIFO:
    def __init__(self):
        self.cola = []  # Lista para almacenar los clientes en espera

    def is_empty(self):
        return len(self.cola) == 0  # Retorna True si no hay clientes

    def push(self, cliente):
        self.cola.append(cliente)  # Agrega el nuevo cliente al final de la fila

    def pop(self):
        if self.is_empty():
            return "No hay clientes en espera"
        return self.cola.pop(0)  # Atiende al PRIMER cliente que llegó (FIFO)

    def pek(self):
        if self.is_empty():
            return "Fila vacía"
        return self.cola[0]  # Muestra al siguiente cliente sin eliminarlo


# --- INICIALIZACIÓN DEL SISTEMA ---
banco = FIFO()
contador_turno = 1

# Llegada de las 5 personas iniciales
personas_iniciales = ["Carlos", "María", "Andrés", "Laura", "Pedro"]

for nombre in personas_iniciales:
    turno = f"T-{contador_turno}: {nombre}"
    banco.push(turno)
    contador_turno += 1

# --- MENÚ INTERACTIVO ---
while True:
    print("\n==============================================")
    print("         DIGITURNO BANCO - SISTEMA FIFO      ")
    print("==============================================")
    print("Clientes en espera :", banco.cola)
    print("Siguiente a módulo  :", banco.pek())
    print("----------------------------------------------")
    print("1. Tomar turno             (Nuevo cliente -> push)")
    print("2. Llamar cliente a caja   (Atención       -> pop)")
    print("3. Salir del sistema")
    print("==============================================")
    
    opc = input("Seleccione una opción (1-3): ")

    if opc == "1":
        nombre = input("Ingrese el nombre del cliente: ")
        nuevo_turno = f"T-{contador_turno}: {nombre}"
        banco.push(nuevo_turno)
        print(f"-> ¡Turno asignado!: {nuevo_turno}")
        contador_turno += 1

    elif opc == "2":
        atendido = banco.pop()
        print(f"-> Atendiendo en Caja al cliente: {atendido}")

    elif opc == "3":
        print("Cerrando el sistema del banco...")
        break
    else:
        print("Opción no válida. Intente de nuevo.")